PROJECT_NAME=MindSpark Backend
VERSION=1.0.0
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBUG=True

# Security
SECRET_KEY=mindspark_super_secret_jwt_key_change_in_production_9876543210
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL for Docker/Production, SQLite fallback for local test without postgres service)
DATABASE_URL=postgresql+asyncpg://mindspark:mindspark_password@localhost:5432/mindspark_db
# For zero-dependency local testing or fallback:
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./mindspark.db

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=False

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20

